        <!-- ============================================================
        TAB 2: 博弈与定价 (⭐ 增强交互版)
        ============================================================ -->
        <div class="ym-tab-content" id="tab2" role="tabpanel">
            <div class="ym-grid-2">
                <!-- 左列：GameBase 博弈均衡 -->
                <div class="ym-card">
                    <div class="ym-card-header">
                        <div class="ym-card-title">⚖️ GameBase 博弈均衡 <span class="badge badge-gold">凯利公式 · 交互</span></div>
                    </div>

                    <!-- 公式推导链条（动态更新） -->
                    <div class="formula-chain" id="formulaChain">
                        <span class="step">f* = (<span class="highlight-gold" id="fB">1.00</span> · <span class="highlight-cyan" id="fP">0.50</span> − <span class="highlight-blue" id="fQ">0.50</span>) / <span class="highlight-gold" id="fBDiv">1.00</span></span>
                        <span class="arrow-symbol">=</span>
                        <span class="step"><span class="highlight-gold" id="fResult">0.000</span></span>
                    </div>

                    <!-- 滑块1: 赔率 b -->
                    <div class="slider-container">
                        <div class="label-row">
                            <span>赔率 <i>b</i>（收益/风险比）</span>
                            <span class="val gold" id="bDisplay">1.00</span>
                        </div>
                        <input type="range" id="bSlider" min="0.50" max="3.00" step="0.01" value="1.00" />
                    </div>

                    <!-- 滑块2: 胜率 p -->
                    <div class="slider-container">
                        <div class="label-row">
